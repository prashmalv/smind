# ─────────────────────────────────────────────────────────────────────────────
# ShopperMind AI — environment
# Copy to .env and fill in. Every AZURE_* value is optional: without them the
# platform runs in local mode with a deterministic reasoner and browser speech.
# ─────────────────────────────────────────────────────────────────────────────

# Core
SHOPPERMIND_ENV=local
API_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:3000

# Database — Azure Database for PostgreSQL Flexible Server in cloud
DATABASE_URL=postgresql+psycopg://shoppermind:shoppermind@localhost:5432/shoppermind

# ── Azure OpenAI (copilot reasoning) ─────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ── Azure AI Speech (voice in / voice out) ───────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_SPEECH_VOICE=en-IN-NeerjaNeural

# ── Azure AI Vision (in-store camera intelligence) ───────────────────────────
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# ── Azure AI Language (sentiment, key phrases, PII redaction) ────────────────
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# ── Azure Blob Storage (frames, clips, exports) ──────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=shoppermind-media

# ── Edge camera agent ────────────────────────────────────────────────────────
SHOPPERMIND_API_URL=http://localhost:8000
CAMERA_AGENT_KEY=
